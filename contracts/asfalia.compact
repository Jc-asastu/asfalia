pragma language_version >= 0.23;

import CompactStandardLibrary;

// ============================================================================
// Asfalia — proof of solvency that expires.
//
// Estado publico (ledger): veredicto, tiempos, commitment de activos y la
// raiz Merkle de pasivos. Estado privado (witnesses): los libros completos.
// Ningun saldo cruza esa linea.
//
// Los pasivos son 16 cuentas de clientes. Cada hoja del arbol es
// hash(id, saldo, salt): el cliente que conoce su terna puede verificar
// que su saldo esta incluido en los pasivos declarados — sin ver el de
// nadie mas, y sin que la entidad pueda esconder cuentas.
// ============================================================================

// --- Estado publico -----------------------------------------------------------

// SOLVENTE (true) / NO SOLVENTE (false). Lo unico que el auditor ve del balance.
export ledger verdict: Boolean;

// Momento del attest (epoch SEGUNDOS — el tiempo de bloque va en segundos),
// validado contra el bloque: el circuito exige que el valor declarado caiga
// en una ventana alrededor del tiempo real, sin antedatar ni posdatar.
export ledger attestedAt: Uint<64>;

// Hasta cuando es aceptable el veredicto (epoch segundos). Pasado este punto
// la cadena misma rechaza el settlement: el certificado VENCE por circuito.
export ledger validUntil: Uint<64>;

// Commitment de los activos + nonce. Ata la prueba a los numeros reales:
// el circuito nunca confia en un valor crudo del prover.
export ledger assetsCommitment: Bytes<32>;

// Raiz Merkle de las cuentas de clientes (los pasivos). El total que el
// circuito uso para el veredicto es la suma de EXACTAMENTE estas hojas.
export ledger liabilitiesRoot: Bytes<32>;

// Autoridad y politica fijadas al desplegar. `ownerKey` es solamente el hash
// de una clave que nunca se publica; la tolerancia y la vigencia ya no son
// parametros elegidos por quien llama a `attest`.
export sealed ledger ownerKey: Bytes<32>;
export sealed ledger attestTolerance: Uint<32>;
export sealed ledger certificateValidity: Uint<32>;

constructor(_ownerSecret: Bytes<32>, _attestTolerance: Uint<32>, _certificateValidity: Uint<32>) {
  assert(_attestTolerance > 0, "attest tolerance must be positive");
  assert(_attestTolerance <= 3600, "attest tolerance exceeds one hour");
  assert(_certificateValidity > 0, "certificate validity must be positive");
  assert(_certificateValidity <= 2678400, "certificate validity exceeds 31 days");

  ownerKey = disclose(ownerKeyFor(_ownerSecret));
  attestTolerance = disclose(_attestTolerance);
  certificateValidity = disclose(_certificateValidity);
}

// --- Estado privado (witnesses, viven en la maquina del prover) ---------------

// Una cuenta de cliente: identificador, saldo en centavos y salt de cegado.
// Sin salt, un hermano del arbol podria adivinar saldos por fuerza bruta.
struct Client {
  id: Bytes<32>;
  balance: Uint<64>;
  salt: Bytes<32>;
}

witness assetBalances(): Vector<8, Uint<64>>;
witness assetsNonce(): Bytes<32>;
witness clientAccounts(): Vector<16, Client>;

// --- Circuitos auxiliares -----------------------------------------------------

export circuit leafHash(c: Client): Bytes<32> {
  return persistentHash<Client>(c);
}

export circuit pairHash(a: Bytes<32>, b: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([a, b]);
}

// Raiz de 16 hojas, niveles explicitos. Verboso a proposito: se lee el arbol.
circuit merkleRoot16(l: Vector<16, Bytes<32>>): Bytes<32> {
  const a = [
    pairHash(l[0], l[1]), pairHash(l[2], l[3]),
    pairHash(l[4], l[5]), pairHash(l[6], l[7]),
    pairHash(l[8], l[9]), pairHash(l[10], l[11]),
    pairHash(l[12], l[13]), pairHash(l[14], l[15])
  ];
  const b = [
    pairHash(a[0], a[1]), pairHash(a[2], a[3]),
    pairHash(a[4], a[5]), pairHash(a[6], a[7])
  ];
  const c = [pairHash(b[0], b[1]), pairHash(b[2], b[3])];
  return pairHash(c[0], c[1]);
}

// Dominio propio: la misma clave no produce el mismo identificador en otro
// contrato que tambien use persistentHash.
circuit ownerKeyFor(_secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "asfalia:owner:"), _secret]);
}

// --- Circuito principal -------------------------------------------------------

// `now` lo declara el prover, pero el circuito lo valida contra el tiempo de
// bloque real: debe cumplirse now <= blockTime < now + attestTolerance.
// Solo quien conoce la clave privada fijada al desplegar puede emitir.
export circuit attest(_ownerSecret: Bytes<32>, now: Uint<64>): [] {
  assert(ownerKeyFor(_ownerSecret) == ownerKey, "only the Asfalia owner can attest");

  const assets = assetBalances();
  const nonce = assetsNonce();
  const clients = clientAccounts();

  // Suma adentro del circuito: la garantia cubre la lista completa,
  // no un agregado que el prover podria fabricar.
  // Acumulador Uint<68>: 16 sumandos de 64 bits caben en 68 bits justos;
  // los saldos reales estan ordenes de magnitud abajo del limite.
  const totalAssets = fold((acc, x) => (acc + x) as Uint<68>, 0 as Uint<68>, assets);
  const totalLiabilities = fold(
    (acc, c) => (acc + c.balance) as Uint<68>,
    0 as Uint<68>,
    clients
  );

  // Los activos quedan atados a un commitment...
  assetsCommitment = disclose(persistentCommit<Vector<8, Uint<64>>>(assets, nonce));

  // ...y los pasivos, a la raiz del arbol de clientes. La suma del veredicto
  // y la raiz publicada salen de las MISMAS hojas: no hay cuenta escondida.
  const leaves = map((c) => leafHash(c), clients);
  liabilitiesRoot = disclose(merkleRoot16(leaves));

  // Validacion temporal: el `now` declarado tiene que estar pegado al bloque.
  const claimed = disclose(now);
  assert(blockTimeGte(claimed), "attest timestamp is in the future");
  assert(blockTimeLt(claimed + attestTolerance as Uint<64>), "attest timestamp is stale");

  attestedAt = claimed;
  validUntil = (claimed + certificateValidity) as Uint<64>;
  verdict = disclose(totalAssets >= totalLiabilities);
}

// El settlement: la contraparte acepta el certificado. Dos condiciones y
// ninguna es opinable — solvente, y todavia vigente. Pasada la ventana,
// la MISMA prueba criptograficamente valida es rechazada por vieja.
export circuit settle(): [] {
  assert(verdict, "certificate is not solvent");
  assert(blockTimeLt(validUntil), "certificate has expired");
}
