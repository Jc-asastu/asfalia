# Asfalia — daemon de attestacion de la entidad.
# 24/7: si el proceso muere se relanza solo (Restart=always); si se corta
# la luz, arranca con la maquina (WantedBy=multi-user.target). El latido
# no depende de que un humano se acuerde de nada.
#
# Instalacion: scripts/install-daemon.sh
[Unit]
Description=Asfalia entity daemon (solvency heartbeat)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/asfalia
# La clave debe ser la misma usada en el constructor. El instalador crea este
# archivo con permisos de root; systemd lo lee antes de bajar privilegios.
EnvironmentFile=/etc/asfalia/asfalia.env
# Produccion: latido diario. La vigencia ya quedo fijada en el constructor.
Environment=ASFALIA_HEARTBEAT_SEC=86400
Environment=PORT=3300
ExecStartPre=/usr/bin/docker compose -f /opt/asfalia/docker-compose.yml up -d proof-server
ExecStart=/usr/bin/npm run api
Restart=always
RestartSec=15
# Los libros son sensibles: nada de core dumps ni escritura fuera del arbol
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/asfalia
UMask=0077

[Install]
WantedBy=multi-user.target
