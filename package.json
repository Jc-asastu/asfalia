{
  "name": "asfalia",
  "version": "1.0.0",
  "type": "module",
  "description": "Proof of Solvency that expires — private solvency attestation on Midnight",
  "author": "",
  "license": "Apache-2.0",
  "scripts": {
    "compile": "compact compile contracts/asfalia.compact contracts/managed/asfalia",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run ui:build",
    "setup": "tsx src/setup.ts",
    "deploy": "tsx src/deploy.ts",
    "attest": "tsx src/attest.ts",
    "api": "tsx api/server.ts",
    "ui:build": "npm --prefix ui run build",
    "dashboard": "npm run ui:build && npm run api",
    "check-balance": "tsx src/check-balance.ts",
    "network": "tsx src/network.ts",
    "proof-server:start": "docker compose up -d",
    "proof-server:stop": "docker compose down",
    "clean": "node --experimental-strip-types scripts/clean.ts",
    "test": "tsx scripts/circuit-check.ts",
    "test:access": "node --experimental-strip-types scripts/access-check.ts",
    "test:runtime": "node --experimental-strip-types scripts/runtime-check.ts",
    "test:score": "node --experimental-strip-types scripts/score-check.ts",
    "test:e2e": "tsx scripts/e2e-check.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@scure/bip39": "2.2.0",
    "rxjs": "^7.8.2",
    "ws": "^8.21.1",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.1.0"
  },
  "keywords": ["midnight", "blockchain", "zero-knowledge", "privacy"]
}
